# ───────────────────────────────────────────────
# 리뷰답글 도우미 설정 파일
# 이 파일을 복사해 .env 로 저장한 뒤 값을 채우세요. (설치 스크립트가 자동으로 복사해 줍니다)
# ───────────────────────────────────────────────

# [AI] Claude API 키. 비워 두면 내장 문장 엔진으로 동작합니다 (무료, 품질은 기본 수준).
# 발급: https://console.anthropic.com
ANTHROPIC_API_KEY=
# 사용할 모델과 생각 깊이(low|medium|high). 답글은 짧은 글이라 low 로도 충분합니다.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# [서버] 포트와 데이터 폴더
PORT=8787
DATA_DIR=data

# [클라우드 모드] 서버를 인터넷(예: Render)에 올렸다면 그 주소를 적으세요.
# 이 PC 의 아이콘을 눌렀을 때 내 PC 에서 서버를 띄우지 않고 그 주소를 앱 창으로 엽니다.
APP_URL=

# [관리자] 요금제를 바꿀 수 있는 관리자 이메일 (쉼표로 여러 개). 비우면 첫 가입 계정이 관리자입니다.
ADMIN_EMAILS=

# [요금제]
TRIAL_DAYS=14
FREE_MONTHLY_LIMIT=10
PRO_MONTHLY_LIMIT=2000
PRICE_TEXT=월 9,900원
# 결제/문의 링크 (예: 카카오톡 채널, 토스 결제 링크). 비우면 버튼이 숨겨집니다.
PAYMENT_URL=

# [업데이트]
# 아이콘으로 실행할 때마다 새 버전을 확인합니다 (0 이면 끔).
UPDATE_ON_LAUNCH=1
# git 으로 받은 폴더는 자동으로 git 방식 업데이트를 씁니다.
# 압축 파일로 받은 경우 아래 매니페스트 주소를 적으면 그 버전 정보를 보고 업데이트합니다.
# 예) https://raw.githubusercontent.com/<계정>/<저장소>/main/update-manifest.json
UPDATE_MANIFEST_URL=
# 비공개 저장소라면 읽기 권한 토큰
UPDATE_TOKEN=

# [고급] 프록시 뒤(Render, Fly.io 등)에서 실행할 때 1
TRUST_PROXY=0
# 다른 출처(앱 번들 등)에서 API 를 호출해야 할 때 허용할 Origin (쉼표 구분)
ALLOWED_ORIGINS=
